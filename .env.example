# Supabase — https://supabase.com/dashboard/project/<seu-projeto>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key (usado no servidor para bypassar RLS — nunca expor no cliente)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# WhatsApp Business Cloud API — https://developers.facebook.com/apps/<app-id>/whatsapp-business/wa-dev-console
WHATSAPP_API_TOKEN=EAAT...
WHATSAPP_PHONE_NUMBER_ID=1234567890
# Token de verificação do webhook Meta (gere um valor aleatório seguro)
WHATSAPP_VERIFY_TOKEN=gere-um-token-aleatorio-aqui
# App Secret do Facebook App (usado para validar assinatura X-Hub-Signature-256)
WHATSAPP_APP_SECRET=seu-app-secret-aqui

# URL pública do app (para links em mensagens)
NEXT_PUBLIC_APP_URL=https://agendamento-mu-ruby.vercel.app

# Langfuse — https://cloud.langfuse.com/settings (opcional — monitora custo LLM)
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
